import sys
import os
from nltk.tokenize import sent_tokenize
from nltk.tokenize import regexp_tokenize


args = sys.argv  # we get the list of arguments from command line
# print('Arguments:', args)
with open(args[1], 'r') as file:
    text = file.read()
    print('cos')
    print('Text:', text)


sentences = sent_tokenize(text)
sum_of_words = 0
for sentence in sentences:
    words = regexp_tokenize(sentence, r"[0-9A-z']+")
    sum_of_words += len(words)
average_number_of_words = sum_of_words / len(sentences)

if average_number_of_words > 10:
    print("Difficulty: HARD")
else:
    print("Difficulty: EASY")







